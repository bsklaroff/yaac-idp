{
  "name": "yaac-idp",
  "version": "0.1.0",
  "description": "An OIDC issuer for apps hosted as yaac sites",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#server/*": "./src/server/*",
    "#web/*": "./src/web/*"
  },
  "scripts": {
    "dev": "node --watch src/server/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node src/server/main.ts",
    "db:migrate": "node src/server/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "lint": "tsc --noEmit && tsc --noEmit -p src/web && tsc --noEmit -p test/web && eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.25",
    "@electric-sql/pglite": "0.5.16",
    "@hono/node-server": "2.1.9",
    "@hono/zod-validator": "0.9.1",
    "better-auth": "1.7.25",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "4.13.19",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "drizzle-kit": "1.0.0-rc.5",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "jose": "6.2.17",
    "jsdom": "31.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
